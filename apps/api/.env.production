# HealthBridge AI — Production Environment
# Copy to .env and fill in values

# App
ENVIRONMENT=production
SECRET_KEY=  # Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
DEBUG=false

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=https://app.healthbridge.ai,https://healthbridge.ai

# Database (RDS)
DATABASE_URL=postgresql+asyncpg://healthbridge:PASSWORD@rds-endpoint:5432/healthbridge

# Redis (ElastiCache)
REDIS_URL=redis://elasticache-endpoint:6379/0

# AWS Infrastructure
AWS_REGION=us-east-1
S3_BUCKET=healthbridge-data-prod
AWS_ACCESS_KEY_ID=  # Use IAM roles in ECS instead
AWS_SECRET_ACCESS_KEY=

# AWS Bedrock (Claude models)
AWS_BEDROCK_REGION=us-east-1
AWS_BEDROCK_ACCESS_KEY_ID=
AWS_BEDROCK_SECRET_ACCESS_KEY=

# Claude Models
ANALYSIS_MODEL=us.anthropic.claude-opus-4-6-v1
DEFAULT_MODEL=us.anthropic.claude-sonnet-4-6
HIGH_COMPLEXITY_MODEL=us.anthropic.claude-opus-4-6-v1

# Storage
STORAGE_BACKEND=s3

# Auth
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
LOGIN_RATE_LIMIT=5
MIN_PASSWORD_LENGTH=8
