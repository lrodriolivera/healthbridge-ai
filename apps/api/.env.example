# App
SECRET_KEY=change-me-in-production
DEBUG=false

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/healthbridge

# Redis
REDIS_URL=redis://localhost:6379/0

# AWS Infrastructure (S3, Secrets Manager, etc.) — Account 367509577730
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=healthbridge-data

# AWS Bedrock (Claude models) — Account 962990060849
AWS_BEDROCK_REGION=us-east-1
AWS_BEDROCK_ACCESS_KEY_ID=
AWS_BEDROCK_SECRET_ACCESS_KEY=

# Claude Models (Bedrock IDs)
DEFAULT_MODEL=anthropic.claude-sonnet-4-6
HIGH_COMPLEXITY_MODEL=anthropic.claude-opus-4-6-v1
FAST_MODEL=anthropic.claude-haiku-4-5-20251001-v1:0
